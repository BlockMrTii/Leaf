+    private int compareBacklogFirst(final ScheduledTick<?> o1, final ScheduledTick<?> o2) {
+        // virtual time: trigger ticks are in the clock of their chunk, compare them on the server clock
+        final long t1 = this.serverTrigger(o1);
+        final long t2 = this.serverTrigger(o2);
+        final boolean overdue1 = t1 < this.orderTick;
+        final boolean overdue2 = t2 < this.orderTick;
+        if (overdue1 != overdue2) {
+            return overdue1 ? -1 : 1;
+        }
+        if (overdue1) {
+            // among overdue ticks the oldest trigger tick goes first
+            final int compare = Long.compare(t1, t2);
+            return compare != 0 ? compare : ScheduledTick.INTRA_TICK_DRAIN_ORDER.compare(o1, o2);
+        }
+        // fresh ticks keep the vanilla order
+        return ScheduledTick.INTRA_TICK_DRAIN_ORDER.compare(o1, o2);
+    }
