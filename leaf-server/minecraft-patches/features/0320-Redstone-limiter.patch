+    // Leaf start - Redstone limiter - measure the block event including its synchronous follow-up work
+    private boolean doBlockEvent(final BlockEventData eventData, final boolean measure) {
+        if (!measure) {
+            return this.doBlockEvent(eventData);
+        }
+
+        final long limiterStart = System.nanoTime();
+        try {
+            return this.doBlockEvent(eventData);
+        } finally {
+            this.redstoneLimiter.record(ChunkPos.pack(eventData.pos()), System.nanoTime() - limiterStart);
+        }
+    }
+    // Leaf end - Redstone limiter
+
     private boolean doBlockEvent(final BlockEventData eventData) {
         BlockState state = this.getBlockState(eventData.pos());
         return state.is(eventData.block()) && state.triggerEvent(this, eventData.pos(), eventData.paramA(), eventData.paramB());
