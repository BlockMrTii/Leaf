+    // Leaf start - Redstone limiter
+    private void runCollectedTicksBudgeted(final BiConsumer<BlockPos, T> output, final long budgetNanos, final long currentTick) {
+        final long start = System.nanoTime();
+        int executed = 0;
+        int deferred = 0;
+        long runUsed = -1L;
+
+        while (!this.toRunThisTick.isEmpty()) {
+            if (executed > 0 && System.nanoTime() - start >= budgetNanos) {
+                runUsed = System.nanoTime() - start; // time spent running ticks only, the hand back below must not inflate avgTickNanos
+                // Budget used up: hand every collected but not yet started tick back to its chunk container. They keep their
+                // trigger tick, priority and sub tick order, so the vanilla drain order applies again next tick. Only duplicates
+                // of an already newly scheduled position are merged, see below.
+                while (!this.toRunThisTick.isEmpty()) {
+                    final ScheduledTick<T> rest = this.toRunThisTick.poll();
+                    if (!this.toRunThisTickSet.isEmpty()) {
+                        this.toRunThisTickSet.remove(rest);
+                    }
+
+                    final LevelChunkTicks<T> container = this.allContainers.get(ChunkPos.pack(rest.pos()));
+                    if (container == null) {
+                        // the chunk was unloaded while this phase ran, vanilla would still run the collected tick
+                        this.alreadyRunThisTick.add(rest);
+                        output.accept(rest.pos(), rest.type());
+                        executed++;
+                    } else if (!container.hasScheduledTick(rest.pos(), rest.type())) {
+                        container.schedule(rest);
+                        deferred++;
+                    }
+                    // else: polling removed the dedupe entry and a callback scheduled the same position and type again, so the
+                    // container already holds a newer tick for it. Vanilla would run both (the collected one now, the new one
+                    // later). To keep the budget, the older one is dropped here and merged into the newer one. This is a
+                    // deliberate timing change (e.g. an observer may switch on later), only possible while the budget is used up.
+                }
+                break;
+            }
+
+            final ScheduledTick<T> entry = this.toRunThisTick.poll();
+            if (!this.toRunThisTickSet.isEmpty()) {
+                this.toRunThisTickSet.remove(entry);
+            }
+
+            this.alreadyRunThisTick.add(entry);
+            output.accept(entry.pos(), entry.type());
+            executed++;
+        }
+
+        final long used = runUsed >= 0L ? runUsed : System.nanoTime() - start;
+        // also learn from few but expensive ticks, otherwise the next tick collects far more than the budget can run
+        if (executed > 0 && (executed >= 16 || deferred > 0)) {
+            this.avgTickNanos = Math.max(200.0D, this.avgTickNanos * 0.8D + (double) used / executed * 0.2D);
+        }
+
+        if (deferred > 0) {
+            this.redstoneLimiter.onBudgetExceeded(currentTick, deferred, used);
+        }
+    }
+    // Leaf end - Redstone limiter
+
